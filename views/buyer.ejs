<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Live Markets - Buyer</title>
    <link rel="stylesheet" href="/buyer.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"> 
</head>
<body>
    <header>
        <header style=" color: rgb(80, 80, 80); padding: 10px;">
    <h1><a href="http://localhost:8080/home/choose/buyer" style="color: rgb(40, 46, 54); text-decoration: none;">Live Markets</a></h1>
    
</header>
        <nav>
            <a href="http://localhost:8080/home/choose/buyer"><i class="fa-solid fa-shop"></i></a>
            <a href="http://localhost:8080/home/choose/buyer/my_bids"><i class="fa-solid fa-cart-shopping"></i></a>
        </nav>
    </header>

    <main>
        <div class="live">
            <h1>Available Crops</h1>
            <img src="https://static.vecteezy.com/system/resources/thumbnails/023/456/818/small_2x/red-live-button-icon-for-tv-and-streaming-on-a-transparent-background-free-png.png" alt="Live">
        </div>

        <div class="crop-list" id="crop-list">
            <% crops.forEach(crop => { %>
                <div class="crop-card">
                    <img src="<%= crop.image_url ? crop.image_url : 'https://via.placeholder.com/150' %>" alt="<%= crop.name %>" width="170" height="150">
                    
                    <h4><%= crop.name %></h4>
                    <p>₹<%= crop.base_price %></p>
                    <p>Current Price: ₹<%= crop.current_bid ? crop.current_bid : crop.base_price %></p>
                    
                    <button class="button-54" style="padding: 12px 24px; font-size: 16px; font-weight: bold; color: rgb(248, 248, 248); background: linear-gradient(45deg, #09ff00, #192b20); border-radius: 8px; transition: all 0.3s ease-in-out;">
                        <a href="http://localhost:8080/home/choose/buyer/<%=crop.crop_id%>/bid" style="color: rgb(255, 255, 255); text-decoration: none; display: block;">Place Bid</a>
                    </button>
                  

                 
                </div>
            <% }); %>
        </div>
    </main>

    <footer>
        <p>&copy; 2023 Farmer App. All rights reserved.</p>
    </footer>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".view-bids").forEach(button => {
                button.addEventListener("click", function () {
                    const cropId = this.getAttribute("data-crop-id");
                    const bidsList = document.getElementById(`bids-${cropId}`);
                    
                    if (bidsList.style.display === "none") {
                        fetch(`/home/choose/buyer/bids?cropId=${cropId}`)
                            .then(response => response.json())
                            .then(data => {
                                bidsList.innerHTML = "<h5>Bids:</h5><ul>";
                                data.bids.forEach(bid => {
                                    bidsList.innerHTML += `<li><strong>${bid.buyer_name}</strong>: ₹${bid.bid_amount}</li>`;
                                });
                                bidsList.innerHTML += "</ul>";
                                bidsList.style.display = "block";
                            })
                            .catch(error => console.error("Error fetching bids:", error));
                    } else {
                        bidsList.style.display = "none";
                    }
                });
            });
        });
    </script>
</body>
</html>
