<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Place a Bid</title>
    <link rel="stylesheet" href="/bid.css">
    <style>
        body {
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #84fab0, #8fd3f4);
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        .bid-container {
            background: #fff;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);
            width: 350px;
            text-align: center;
        }

        h2 {
            color: #333;
            margin-bottom: 15px;
        }

        label {
            display: block;
            margin-top: 12px;
            font-weight: bold;
            text-align: left;
        }

        p {
            background: #f4f4f4;
            padding: 8px;
            border-radius: 5px;
            text-align: left;
        }

        input {
            width: calc(100% - 20px);
            padding: 10px;
            margin-top: 5px;
            border: 1px solid #ccc;
            border-radius: 5px;
            outline: none;
            font-size: 14px;
        }

        button {
            background: linear-gradient(45deg, #0f9d58, #0a7f42);
            color: white;
            padding: 12px;
            border: none;
            border-radius: 5px;
            font-size: 16px;
            cursor: pointer;
            margin-top: 15px;
            width: 100%;
            transition: 0.3s ease-in-out;
        }

        button:hover {
            background: linear-gradient(45deg, #0a7f42, #066634);
        }
    </style>
</head>
<body>

    <div class="bid-container">
        <h2>Place Your Bid</h2>

        <% if (crop) { %>
            <form action="/home/choose/buyer/<%= crop.crop_id %>/bid" method="POST">
                <input type="hidden" name="crop_id" value="<%= crop.crop_id %>">

                <label>Crop Name:</label>
                <p><%= crop.name %> (<%= crop.quality %>)</p>

                <label>Base Price (₹):</label>
                <p>₹<%= crop.base_price %></p>

                <label for="b_name">Your Name:</label>
                <input type="text" name="buyer_name" id="b_name" required>

                <label for="bidAmount">Your Bid Amount (₹):</label>
                <input type="number" name="bid_amount" id="bidAmount" required>

                <button type="submit">Submit Bid</button>
            </form>
        <% } else { %>
            <p style="color: red;">Error: Crop details not found.</p>
        <% } %>
    </div>

</body>
</html>
