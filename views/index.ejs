                            <ul>
                                <li>Access high-quality crops directly from farmers.</li>
                                <li>Competitive bidding ensures the best prices.</li>
                                <li>Transparent and secure transactions.</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </section>

    <footer class="footer text-center">
        <hr>
        <p>&copy; 2023 Farmers & Buyers Marketplace. All rights reserved.</p>
    </footer>


    <script>
    if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
    }
    window.scrollTo(0, 0);

    async function fetchCropPrices() {
        try {
            const response = await fetch("/crop-prices");
            const crops = await response.json();
            let tickerText = "🚜 Latest Crop Prices: ";
            
            crops.forEach(crop => {
                tickerText += `${crop.name} - ₹${crop.base_price} | `;
            });

            document.getElementById("ticker").textContent = tickerText;
        } catch (error) {
            console.error("Error fetching crop prices:", error);
        }
    }

    fetchCropPrices();
    </script>
</body>
</html>