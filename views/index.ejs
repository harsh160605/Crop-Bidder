    <h2 class="text-center">How It Works?</h2>
    <!-- work -->
    <section class="cards" id="how-it-works">
        
      <div class="card w-25 fade-in" class="card">
        <div class="card-body">
            
          <h5 class="card-title">1. List Crops</h5>
          <p class="card-text">Farmers list their crops with a base price.</p>
          <!-- <a href="#" class="btn btn-primary">Button</a> -->
        </div>
      </div>

      <div class="card w-25" class="card">
        <div class="card-body">
          <h5 class="card-title">2. Place Bids</h5>
          <p class="card-text" class="text-center">Buyers place bids on the listed crops.</p>
          <!-- <a href="#" class="btn btn-primary">Button</a> -->
        </div>
      </div>


      <div class="card w-25" class="card">
        <div class="card-body">
          <h5 class="card-title">3. Sell Crops</h5>
          <p class="card-text" class="text-center">Farmers choose the best bid & sell their crops.</p>
          <!-- <a href="#" class="btn btn-primary">Button</a> -->
        </div>
      </div>
    </section>


        <!-- Benefits Section -->
        <section id="benefits" class="section bg-light">
            <div class="container">
                <h2 class="text-center">Benefits</h2>
                <div class="row">
                    <div class="col-md-6 fade-in">
                        <div class="card p-4">
                            <h3>For Farmers</h3>
                            <ul>
                                <li>Get fair prices for your crops.</li>
                                <li>Reach a wider market of buyers.</li>
                                <li>Control when and to whom you sell.</li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-md-6 fade-in">
                        <div class="card p-4">
